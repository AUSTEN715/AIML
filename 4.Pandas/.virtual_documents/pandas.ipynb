date_str = pd.Series([pd.to_datetime('2026-10-24')])
type(date_str.dtype)


#handle strings 
df["gender"].str.capitalize()
df["name"].str.split(" ")

df["country"].str.contains("india", case=False)


df


# Feature Engineering
df2 = df.copy()

df2["tax"] = df2["income"].apply(lambda x : "20%" if x >= 60000 else "10%")


gender_map = {"Male" : "M", "Female": "F", "Unknown": "U"}
# df2["gender"].map(gender_map)
df2["gender"] = df2["gender"].map(gender_map)

# df2.assign(new_income = df2["income"] * 1.1)
df2 = df2.assign(new_income = df2["income"] * 1.1)

df2["country"] = df2["country"].replace("USA", "US")



#Functions transform data
df2.rename(columns={"income": "salary"})
df2.rename(index={1:"one"})

df2.sort_values("income")
df2.sort_values("income", ascending=False)
sorted_df = df2.sort_values(["income", "age"])

sorted_df.sort_index()

#reset
sorted_df.reset_index()
sorted_df.reset_index(drop=True)

#ranking 
sorted_df["Ranking"] = sorted_df["income"].rank(ascending=False, method="max")

#Change the colms position
sorted_df[["id", "name", "age", "country", "gender", "income", "new_income", "Ranking", "tax"]]


#Task --> id --> last


new_col_order = [col for col in df2.columns if col != "id"] + ["id"]
# new_col_order
df2[new_col_order]


#Writing to csv
