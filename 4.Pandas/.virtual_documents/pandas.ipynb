#Cleaning the data

df = pd.read_csv("raw_data.csv")


#Handling missing values

df.isnull()
df.isnull().sum()
df.dropna() # drop all the rows cointaining null
df.dropna(axis=1) # col drop
df.fillna(0)
df["age"].fillna(df["age"].mean())

df.ffill()
df.bfill()


#Handle duplicate values
df.duplicated()
df[["country", "gender"]].duplicated() # two colms compare

