#Grouping & Aggregation of data

df.groupby("country")["income"].mean()
df.groupby("country")["income"].min()
df.groupby("country")["income"].max()

df.groupby("gender")["income"].mean()

df.groupby("country")["income"].agg(["mean", "min", "max"])
df.groupby("country")["income"].aggregate(["mean", "min", "max"])

df.groupby("country")["income"].agg(avg_salary="mean", min_salary="min", max_salary="max")

#Use of multiple column
df.groupby("country").agg({
    "income": "mean",
    "age": "mean"
})

df.groupby("country").agg(
    max_salary=("income","max"),
    avg_age=("age", "mean")
)




df = pd.DataFrame({
    "country": ["USA", "USA", "India", "India"],
    "year": [2020,2021,2020,2021],
    "sales": [100, 120, 90, 110],
    "profit": [20, 25,18, 22],
    # "tax": [10,20,30,40]
})

df


#Melt and Pivot

melted_df = df.melt(
    id_vars=["country", "year"], #Preseve
    value_vars=["sales", "profit"], # Data in single column
    var_name="metrics", # Name of the new col
    value_name="value" # Name of the values col
)


original = melted_df.pivot(
    index=["country","year"], # Unique values --> so we used both 
    columns="metrics", # Create cols
    values="value"
)

original



